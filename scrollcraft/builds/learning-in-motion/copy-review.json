    {
      "id": "SAMPLE.listen.title",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "Who hasn’t had a say?"
    },
    {
      "id": "SAMPLE.listen.category",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "Listening"
    },
    {
      "id": "SAMPLE.listen.lessonTitle",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "Silence is not the same as agreement."
    },
    {
      "id": "SAMPLE.listen.lessonBody",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "Someone who is quiet might agree, need more time or struggle to find a gap. Silence alone does not tell you which. Listening means creating room for another perspective, without making anyone feel they have to speak."
    },
    {
      "id": "SAMPLE.listen.lessonExample",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "Your group is ready to choose a plan. Two people have done most of the talking. Try: “Before we decide, is there anything we have missed?” Pause, give others time, and leave room to pass."
    },
    {
      "id": "SAMPLE.listen.takeaway",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "Create an opening. Leave a choice. Give the next voice your attention."
    },
    {
      "id": "SAMPLE.listen.question",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "How would you open up the conversation?"
    },
    {
      "id": "SAMPLE.listen.context",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "Your group is about to make a decision. One person has not spoken, and you want to hear any views the group may be missing."
    },
    {
      "id": "SAMPLE.listen.idea",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "Make space without putting someone on the spot."
    },
    {
      "id": "SAMPLE.listen.discussion",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "What makes it easier to speak up in your group? What makes it harder?"
    },
    {
      "id": "SAMPLE.listen.mission",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "In your next group discussion, invite another perspective. Give people time to respond and room to pass."
    },
    {
      "id": "SAMPLE.listen.answer.A",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "Ask everyone to give an opinion before you move on.",
      "note": "Incorrect answer; visitor can retry."
    },
    {
      "id": "SAMPLE.listen.answer.B",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "Invite other views, with time to respond and room to pass.",
      "note": "Correct answer for this question."
    },
    {
      "id": "SAMPLE.listen.feedback.incorrect.heading",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "Equal turns can still create pressure."
    },
    {
      "id": "SAMPLE.listen.feedback.incorrect.body",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "Asking everyone to speak sounds inclusive, but it can put someone on the spot. Offer an invitation they can accept or pass on, then give them time."
    },
    {
      "id": "SAMPLE.listen.feedback.correct.heading",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "An invitation, not an obligation."
    },
    {
      "id": "SAMPLE.listen.feedback.correct.body",
      "group": "Sample · Who hasn’t had a say?",
      "copy": "You have created a way into the conversation without demanding an answer. Now pause and give anyone who responds your attention."
    },
    {
      "id": "SAMPLE.think.title",
      "group": "Sample · Would you pass this on?",
      "copy": "Would you pass this on?"
    },
    {
      "id": "SAMPLE.think.category",
      "group": "Sample · Would you pass this on?",
      "copy": "Clear thinking"
    },
    {
      "id": "SAMPLE.think.lessonTitle",
      "group": "Sample · Would you pass this on?",
      "copy": "Being believable is not the same as being true."
    },
    {
      "id": "SAMPLE.think.lessonBody",
      "group": "Sample · Would you pass this on?",
      "copy": "A message can come from someone you trust and still contain a claim they have not checked. Knowing who passed it on is not the same as knowing where it began or what evidence supports it."
    },
    {
      "id": "SAMPLE.think.lessonExample",
      "group": "Sample · Would you pass this on?",
      "copy": "A friend sends a screenshot saying a local event has been cancelled, but the date and source are missing. Before forwarding it, check the organiser’s original announcement and whether it refers to the right event and date."
    },
    {
      "id": "SAMPLE.think.takeaway",
      "group": "Sample · Would you pass this on?",
      "copy": "Trace the source. Check the date and evidence. Then decide whether to share."
    },
    {
      "id": "SAMPLE.think.question",
      "group": "Sample · Would you pass this on?",
      "copy": "Your group plans to attend. What next?"
    },
    {
      "id": "SAMPLE.think.context",
      "group": "Sample · Would you pass this on?",
      "copy": "Someone you trust sends a screenshot saying an event has been cancelled. It has no date or source, and nobody has checked with the organiser."
    },
    {
      "id": "SAMPLE.think.idea",
      "group": "Sample · Would you pass this on?",
      "copy": "Give a convincing claim a closer look."
    },
    {
      "id": "SAMPLE.think.discussion",
      "group": "Sample · Would you pass this on?",
      "copy": "What makes a claim feel trustworthy? What would actually help you check it?"
    },
    {
      "id": "SAMPLE.think.mission",
      "group": "Sample · Would you pass this on?",
      "copy": "Before sharing your next news story, find the original source and check whether it supports the claim."
    },
    {
      "id": "SAMPLE.think.answer.A",
      "group": "Sample · Would you pass this on?",
      "copy": "Share it with a warning that it might be wrong.",
      "note": "Incorrect answer; visitor can retry."
    },
    {
      "id": "SAMPLE.think.answer.B",
      "group": "Sample · Would you pass this on?",
      "copy": "Check the source and evidence before sharing.",
      "note": "Correct answer for this question."
    },
    {
      "id": "SAMPLE.think.feedback.incorrect.heading",
      "group": "Sample · Would you pass this on?",
      "copy": "A warning is not a fact-check."
    },
    {
      "id": "SAMPLE.think.feedback.incorrect.body",
      "group": "Sample · Would you pass this on?",
      "copy": "Saying you are unsure is honest, but the claim still reaches more people. Check the source and evidence before passing it on as news."
    },
    {
      "id": "SAMPLE.think.feedback.correct.heading",
      "group": "Sample · Would you pass this on?",
      "copy": "Check first. Then decide."
    },
    {
      "id": "SAMPLE.think.feedback.correct.body",
      "group": "Sample · Would you pass this on?",
      "copy": "An original source gives you something to assess, not automatic proof. Check its date and whether the evidence supports the claim before deciding to share."
    },
    {
      "id": "SAMPLE.act.title",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "Same invitation. Same chance?"
    },
    {
      "id": "SAMPLE.act.category",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "Everyday fairness"
    },
    {
      "id": "SAMPLE.act.lessonTitle",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "Being invited is not always enough."
    },
    {
      "id": "SAMPLE.act.lessonBody",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "Everyone can receive the same invitation without having the same chance to join. If the same person keeps missing out, look at the arrangement as well as the individual. What might be making participation difficult?"
    },
    {
      "id": "SAMPLE.act.lessonExample",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "Your group always meets in the afternoon. Someone with a regular commitment has missed two meetings. Instead of assuming they are not interested, ask what might help: another time, rotating meetings or a different way to contribute."
    },
    {
      "id": "SAMPLE.act.takeaway",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "Notice who keeps missing out. Ask about the barrier. Explore what could change."
    },
    {
      "id": "SAMPLE.act.question",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "How should the group choose its meeting time?"
    },
    {
      "id": "SAMPLE.act.context",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "Most people prefer afternoons. One member has a regular commitment then and has missed the last two meetings."
    },
    {
      "id": "SAMPLE.act.idea",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "Look beyond the invitation to the chance to take part."
    },
    {
      "id": "SAMPLE.act.discussion",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "Who keeps missing out on your group’s activities? What could you change to make joining easier?"
    },
    {
      "id": "SAMPLE.act.mission",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "Ask someone who rarely joins a group activity what would make it easier to take part. Explore one change together."
    },
    {
      "id": "SAMPLE.act.answer.A",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "Hold a vote and use the most popular time.",
      "note": "Incorrect answer; visitor can retry."
    },
    {
      "id": "SAMPLE.act.answer.B",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "Explore alternatives before choosing a time.",
      "note": "Correct answer for this question."
    },
    {
      "id": "SAMPLE.act.feedback.incorrect.heading",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "A vote can miss a recurring barrier."
    },
    {
      "id": "SAMPLE.act.feedback.incorrect.body",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "A majority vote tells you what most people prefer, but not what keeps someone from joining. Ask about the barrier and explore options before settling on a time."
    },
    {
      "id": "SAMPLE.act.feedback.correct.heading",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "Understand the barrier before deciding."
    },
    {
      "id": "SAMPLE.act.feedback.correct.body",
      "group": "Sample · Same invitation. Same chance?",
      "copy": "You have not promised a perfect time for everyone. You have made room to consider another time, rotating meetings or a different way to contribute."
    },
